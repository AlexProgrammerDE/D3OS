unsafe fn vector_project_template<const BF16: bool, const GATED: bool>(a: *const f32, b: *const f32, up: *const f32, output: *mut f32, inner: u32, cols: u32) {
    let block: u32 = block_id();
    let first = block * unsigned(TILE_COLUMNS);
    let col: Tile<u32, { [TILE_COLUMNS] }> = lanes::<TILE_COLUMNS>() + broadcast_scalar(first, shape![TILE_COLUMNS]);
    let col: Tile<u32, { [TILE_COLUMNS, 1] }> = col.reshape(shape![TILE_COLUMNS, 1]);
    let col: Tile<u32, { [TILE_COLUMNS, 128] }> = col.broadcast(shape![TILE_COLUMNS, 128]);
    let k: Tile<u32, { [128] }> = lanes::<128>();
    let k: Tile<u32, { [1, 128] }> = k.reshape(shape![1, 128]);
    let k: Tile<u32, { [TILE_COLUMNS, 128] }> = k.broadcast(shape![TILE_COLUMNS, 128]);
    let mut sum: Tile<f32, { [TILE_COLUMNS, 128] }> = broadcast_scalar(0f32, shape![TILE_COLUMNS, 128]);
    let mut up_sum: Tile<f32, { [TILE_COLUMNS, 128] }> = broadcast_scalar(0f32, shape![TILE_COLUMNS, 128]);
    let mut start = 0u32;
    while start < inner {
        let k = k + broadcast_scalar(start, shape![TILE_COLUMNS, 128]);
        let mask = lt_tile(col, broadcast_scalar(cols, shape![TILE_COLUMNS, 128])) & lt_tile(k, broadcast_scalar(inner, shape![TILE_COLUMNS, 128]));
        let input_index = lanes::<128>() + broadcast_scalar(start, shape![128]);
        let input_mask = lt_tile(input_index, broadcast_scalar(inner, shape![128]));
        let input = unsafe { read_tile(a, input_index, input_mask, 0f32) };
        let input: Tile<f32, { [1, 128] }> = input.reshape(shape![1, 128]);
        let x: Tile<f32, { [TILE_COLUMNS, 128] }> = input.broadcast(shape![TILE_COLUMNS, 128]);
        let index = col * broadcast_scalar(inner, shape![TILE_COLUMNS, 128]) + k;
        let w: Tile<f32, { [TILE_COLUMNS, 128] }> = unsafe { read_weights::<BF16, false, TILE_COLUMNS, 128, FLAT_VALUES>(b, index, mask, shape![FLAT_VALUES]) };
        let x: Tile<f32, { [TILE_COLUMNS, 128] }> = x.reshape(shape![TILE_COLUMNS, 128]);
        let w: Tile<f32, { [TILE_COLUMNS, 128] }> = w.reshape(shape![TILE_COLUMNS, 128]);
        sum = fma(x, w, sum, rounding::NearestEven, ftz::Disabled);
        if GATED {
            let w: Tile<f32, { [TILE_COLUMNS, 128] }> = unsafe { read_weights::<BF16, false, TILE_COLUMNS, 128, FLAT_VALUES>(up, index, mask, shape![FLAT_VALUES]) };
            let w: Tile<f32, { [TILE_COLUMNS, 128] }> = w.reshape(shape![TILE_COLUMNS, 128]);
            up_sum = fma(x, w, up_sum, rounding::NearestEven, ftz::Disabled);
        }

        start = start + 128u32;
    }
    let sum: Tile<f32, { [TILE_COLUMNS] }> = reduce_sum(sum, 1i32);
    let value = if GATED {
        let u: Tile<f32, { [TILE_COLUMNS] }> = reduce_sum(up_sum, 1i32);
        silu_tile(sum) * u
    } else {
        sum
    };
    let col: Tile<u32, { [TILE_COLUMNS] }> = lanes::<TILE_COLUMNS>() + broadcast_scalar(first, shape![TILE_COLUMNS]);
    let mask = lt_tile(col, broadcast_scalar(cols, shape![TILE_COLUMNS]));
    unsafe { write_tile(output, col, value, mask) };
}
