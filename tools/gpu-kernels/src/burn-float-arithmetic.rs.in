// Floating arithmetic and sqrt retain their type and round to nearest even.
// Typed half division uses tileiras's documented F32 emulation internally.
// Half remainder explicitly computes and corrects in F32 before one output rounding.
// Half exp/log explicitly promote to F32 before one destination RNE rounding.
fn float_arithmetic_width(format: u32) -> u32 {
    if format == 0u32 { 3u32 } else if format <= 2u32 { 2u32 } else { 1u32 }
}

fn float_arithmetic_one(format: u32) -> u64 {
    if format == 0u32 { 1072693248u64 << 32u64 }
    else if format <= 2u32 { 1065353216u64 }
    else if format == 3u32 { 15360u64 }
    else { 16256u64 }
}

// Round stored IEEE encodings without floating math or integer-value conversion.
fn float_arithmetic_integral_u32(bits: Tile<u32, {[128]}>, op: u32, fraction: u32, bias: u32, sign_shift: u32) -> Tile<u32, {[128]}> {
    let zero = broadcast_scalar(0u32, shape![128]);
    let one = broadcast_scalar(1u32, shape![128]);
    let f = broadcast_scalar(fraction, shape![128]);
    let base = broadcast_scalar(bias, shape![128]);
    let sign = one << broadcast_scalar(sign_shift, shape![128]);
    // Ignore bits outside the stored format before classification or passthrough.
    let bits = bits & (sign | (sign - one));
    let sign_bits = bits & sign;
    let magnitude_mask = sign - one;
    let magnitude = bits & magnitude_mask;
    let exponent = magnitude >> f;
    let negative = ne_tile(sign_bits, zero);
    let nonzero = ne_tile(magnitude, zero);
    let one_bits = base << f;
    let half_bits = (base - one) << f;
    let max_exponent = base + f - one;
    let bounded_low = select(lt_tile(exponent, base), base, exponent);
    let bounded_exponent = select(gt_tile(bounded_low, max_exponent), max_exponent, bounded_low);
    // Every lane has 1 <= k <= fraction, even zero, infinity, and NaN lanes.
    let k = base + f - bounded_exponent;
    let unit = one << k;
    let mask = unit - one;
    let remainder = magnitude & mask;
    let whole = magnitude & (magnitude_mask ^ mask);
    let significand = (one << f) | (magnitude & ((one << f) - one));
    let odd = ne_tile((significand >> k) & one, zero);
    let half = unit >> broadcast_scalar(1u32, shape![128]);
    let remainder_nonzero = ne_tile(remainder, zero);
    let increment = if op == 21u32 { negative & remainder_nonzero }
        else if op == 22u32 { eq_tile(sign_bits, zero) & remainder_nonzero }
        else if op == 23u32 { gt_tile(remainder, half) | (eq_tile(remainder, half) & odd) }
        else { ne_tile(zero, zero) };
    let middle = sign_bits | (whole + select(increment, unit, zero));
    let small_increment = if op == 21u32 { negative & nonzero }
        else if op == 22u32 { eq_tile(sign_bits, zero) & nonzero }
        else if op == 23u32 { gt_tile(magnitude, half_bits) }
        else { ne_tile(zero, zero) };
    let small = sign_bits | select(small_increment, one_bits, zero);
    select(lt_tile(exponent, base), small, select(ge_tile(exponent, base + f), bits, middle))
}

// Round stored IEEE encodings without floating math or integer-value conversion.
fn float_arithmetic_integral_u64(bits: Tile<u64, {[128]}>, op: u32, fraction: u64, bias: u64, sign_shift: u64) -> Tile<u64, {[128]}> {
    let zero = broadcast_scalar(0u64, shape![128]);
    let one = broadcast_scalar(1u64, shape![128]);
    let f = broadcast_scalar(fraction, shape![128]);
    let base = broadcast_scalar(bias, shape![128]);
    let sign = one << broadcast_scalar(sign_shift, shape![128]);
    // Ignore bits outside the stored format before classification or passthrough.
    let bits = bits & (sign | (sign - one));
    let sign_bits = bits & sign;
    let magnitude_mask = sign - one;
    let magnitude = bits & magnitude_mask;
    let exponent = magnitude >> f;
    let negative = ne_tile(sign_bits, zero);
    let nonzero = ne_tile(magnitude, zero);
    let one_bits = base << f;
    let half_bits = (base - one) << f;
    let max_exponent = base + f - one;
    let bounded_low = select(lt_tile(exponent, base), base, exponent);
    let bounded_exponent = select(gt_tile(bounded_low, max_exponent), max_exponent, bounded_low);
    // Every lane has 1 <= k <= fraction, even zero, infinity, and NaN lanes.
    let k = base + f - bounded_exponent;
    let unit = one << k;
    let mask = unit - one;
    let remainder = magnitude & mask;
    let whole = magnitude & (magnitude_mask ^ mask);
    let significand = (one << f) | (magnitude & ((one << f) - one));
    let odd = ne_tile((significand >> k) & one, zero);
    let half = unit >> broadcast_scalar(1u64, shape![128]);
    let remainder_nonzero = ne_tile(remainder, zero);
    let increment = if op == 21u32 { negative & remainder_nonzero }
        else if op == 22u32 { eq_tile(sign_bits, zero) & remainder_nonzero }
        else if op == 23u32 { gt_tile(remainder, half) | (eq_tile(remainder, half) & odd) }
        else { ne_tile(zero, zero) };
    let middle = sign_bits | (whole + select(increment, unit, zero));
    let small_increment = if op == 21u32 { negative & nonzero }
        else if op == 22u32 { eq_tile(sign_bits, zero) & nonzero }
        else if op == 23u32 { gt_tile(magnitude, half_bits) }
        else { ne_tile(zero, zero) };
    let small = sign_bits | select(small_increment, one_bits, zero);
    select(lt_tile(exponent, base), small, select(ge_tile(exponent, base + f), bits, middle))
}

fn float_arithmetic_power_f64(a: Tile<u64, {[128]}>, b: Tile<u64, {[128]}>) -> Tile<u64, {[128]}> {
    let zero = broadcast_scalar(0u64, shape![128]);
    let unit = broadcast_scalar(1u64, shape![128]);
    let sign = unit << broadcast_scalar(63u64, shape![128]);
    let implicit = unit << broadcast_scalar(52u64, shape![128]);
    let fraction_mask = implicit - unit;
    let one = broadcast_scalar(1023u64, shape![128]) << broadcast_scalar(52u64, shape![128]);
    let infinity = broadcast_scalar(2047u64, shape![128]) << broadcast_scalar(52u64, shape![128]);
    let nan = infinity | (unit << broadcast_scalar(51u64, shape![128]));
    let negative_one = sign | one;
    let x_negative_one = eq_tile(a, negative_one);
    let ax = a & (sign - unit);
    let ay = b & (sign - unit);
    let ex = ax >> broadcast_scalar(52u64, shape![128]);
    let ey = ay >> broadcast_scalar(52u64, shape![128]);
    let fx = ax & fraction_mask;
    let fy = ay & fraction_mask;
    let x_negative = ne_tile(a & sign, zero);
    let y_negative = ne_tile(b & sign, zero);
    let y_finite = lt_tile(ay, infinity);
    let x_large = gt_tile(ax, one);
    let x_nan = gt_tile(ax, infinity);
    let y_nan = gt_tile(ay, infinity);
    let y_infinite = eq_tile(ay, infinity);

    // Decode integer parity from the stored exponent, with every shift in 0..=52.
    let bounded_ey = min_tile(max_tile(ey, broadcast_scalar(1023u64, shape![128])), broadcast_scalar(1075u64, shape![128]));
    let parity_shift = broadcast_scalar(1075u64, shape![128]) - bounded_ey;
    let significand = implicit | fy;
    let integer = y_finite & (eq_tile(ay, zero) | (ge_tile(ey, broadcast_scalar(1023u64, shape![128])) & eq_tile(significand & ((unit << parity_shift) - unit), zero)));
    let odd = integer & ge_tile(ey, broadcast_scalar(1023u64, shape![128])) & le_tile(ey, broadcast_scalar(1075u64, shape![128])) & ne_tile((significand >> parity_shift) & unit, zero);
    let result_sign = select(odd, a & sign, zero);

    // A subnormal power of two has one fraction bit. Find its index in six steps.
    let mut bits = fx;
    let mut index = zero;
    let upper = ne_tile(bits >> broadcast_scalar(32u64, shape![128]), zero);
    bits = select(upper, bits >> broadcast_scalar(32u64, shape![128]), bits);
    index = index + select(upper, broadcast_scalar(32u64, shape![128]), zero);
    let upper = ne_tile(bits >> broadcast_scalar(16u64, shape![128]), zero);
    bits = select(upper, bits >> broadcast_scalar(16u64, shape![128]), bits);
    index = index + select(upper, broadcast_scalar(16u64, shape![128]), zero);
    let upper = ne_tile(bits >> broadcast_scalar(8u64, shape![128]), zero);
    bits = select(upper, bits >> broadcast_scalar(8u64, shape![128]), bits);
    index = index + select(upper, broadcast_scalar(8u64, shape![128]), zero);
    let upper = ne_tile(bits >> broadcast_scalar(4u64, shape![128]), zero);
    bits = select(upper, bits >> broadcast_scalar(4u64, shape![128]), bits);
    index = index + select(upper, broadcast_scalar(4u64, shape![128]), zero);
    let upper = ne_tile(bits >> broadcast_scalar(2u64, shape![128]), zero);
    bits = select(upper, bits >> broadcast_scalar(2u64, shape![128]), bits);
    index = index + select(upper, broadcast_scalar(2u64, shape![128]), zero);
    index = index + select(ne_tile(bits >> unit, zero), unit, zero);
    let subnormal = eq_tile(ex, zero);
    let power_of_two = (subnormal & ne_tile(fx, zero) & eq_tile(fx & (fx - unit), zero))
        | (ne_tile(ex, zero) & lt_tile(ax, infinity) & eq_tile(fx, zero));
    let k_negative = lt_tile(ex, broadcast_scalar(1023u64, shape![128]));
    let k_magnitude = select(subnormal, broadcast_scalar(1074u64, shape![128]) - index,
        select(k_negative, broadcast_scalar(1023u64, shape![128]) - ex, ex - broadcast_scalar(1023u64, shape![128])));
    let eligible = power_of_two & ne_tile(k_magnitude, zero) & y_finite & (eq_tile(a & sign, zero) | integer);
    let decays = eligible & (k_negative ^ y_negative);

    // For |x|=2^k, RNE is zero exactly when k*y <= -1075, including the tie.
    // |y|<=1 cannot cross. In 1<|y|<1075, compare exact integer products.
    // M*|k| < 1074*2^53 < 2^64. The clamped shift stays in 42..=52 in every lane.
    let cutoff = broadcast_scalar(0x4090cc00u64, shape![128]) << broadcast_scalar(32u64, shape![128]);
    let bounded_ey = min_tile(max_tile(ey, broadcast_scalar(1023u64, shape![128])), broadcast_scalar(1033u64, shape![128]));
    let cutoff_shift = broadcast_scalar(1075u64, shape![128]) - bounded_ey;
    let crosses = ge_tile(ay, cutoff) | (gt_tile(ay, one) & ge_tile(significand * k_magnitude, broadcast_scalar(1075u64, shape![128]) << cutoff_shift));
    let x: Tile<f64, {[128]}> = bitcast(a);
    let y: Tile<f64, {[128]}> = bitcast(b);
    let vendor: Tile<u64, {[128]}> = bitcast(pow(x, y));
    // A zero on the nonzero side becomes the minimum subnormal with the exact sign.
    // Its two-step accuracy still requires the vendor error premise near underflow.
    let nonzero = select(eq_tile(vendor & (sign - unit), zero), result_sign | unit, vendor);
    let mut result = select(decays, select(crosses, result_sign, nonzero), vendor);

    // Mathematical identities and special classes precede the generic result.
    // Stored wrapper shortcut schedules remain separate from this Power operation.
    result = select(eq_tile(b, one), a, result);
    result = select(x_negative_one & integer, select(odd, negative_one, one), result);
    result = select(x_negative & lt_tile(ax, infinity) & ne_tile(ax, zero) & y_finite & (integer ^ broadcast_scalar(true, shape![128])), nan, result);
    result = select(eq_tile(ax, zero), result_sign | select(y_negative, infinity, zero), result);
    result = select(eq_tile(ax, infinity), result_sign | select(y_negative, zero, infinity), result);
    let infinite_exponent = select(x_large ^ y_negative, infinity, zero);
    result = select(y_infinite, infinite_exponent, result);
    result = select(x_nan | y_nan, nan, result);
    result = select(x_negative_one & y_infinite, one, result);
    result = select(eq_tile(a, one), one, result);
    select(eq_tile(ay, zero), one, result)
}

fn float_arithmetic_f64(a: Tile<u64, {[128]}>, b: Tile<u64, {[128]}>, op: u32) -> Tile<u64, {[128]}> {
    let x: Tile<f64, {[128]}> = bitcast(a);
    let y: Tile<f64, {[128]}> = bitcast(b);
    let one: Tile<f64, {[128]}> = bitcast(broadcast_scalar(1072693248u64 << 32u64, shape![128]));
    if op == 1u32 { bitcast(addf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 2u32 { bitcast(subf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 3u32 { bitcast(mulf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 4u32 { bitcast(divf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 14u32 { bitcast(sqrt(x, rounding::NearestEven, ftz::Disabled)) }
    else if op == 15u32 {
        let zero = broadcast_scalar(0u64, shape![128]);
        let minimum = broadcast_scalar(1u64, shape![128]);
        let sign = minimum << broadcast_scalar(63u64, shape![128]);
        // First F64 above ln(2^-1075), the zero/minimum-subnormal RNE midpoint.
        let high = broadcast_scalar(1082607888u64, shape![128]) << broadcast_scalar(32u64, shape![128]);
        let low = (broadcast_scalar(54573u64, shape![128]) << broadcast_scalar(16u64, shape![128])) | broadcast_scalar(12369u64, shape![128]);
        let cutoff_bits = (high | low) ^ sign;
        let cutoff: Tile<f64, {[128]}> = bitcast(cutoff_bits);
        let underflow = lt_tile(x, cutoff);
        let result: Tile<u64, {[128]}> = bitcast(unsafe { exp_with_rounding(x, rounding::Full) });
        // An observed one-ULP error can erase the minimum subnormal.
        // The project requires nonzero results to stay nonzero.
        let nonzero = select(eq_tile(result & (sign - minimum), zero), minimum, result);
        select(underflow, zero, nonzero)
    }
    else if op == 16u32 { bitcast(log(x)) }
    else if op == 17u32 { float_math_log1p_f64(a) }
    else if op == 18u32 { bitcast(unsafe { tanh_with_rounding(x, rounding::Full) }) }
    else if op == 19u32 { bitcast(sin(x)) }
    else if op == 20u32 { bitcast(cos(x)) }
    else if op == 29u32 { float_arithmetic_power_f64(a, b) }
    else if op == 30u32 { bitcast(sinh(x)) }
    else if op == 31u32 { bitcast(cosh(x)) }
    else if op == 32u32 { bitcast(tan(x)) }
    else if op == 34u32 {
        let residue = remf(x, y);
        let bits: Tile<u64, {[128]}> = bitcast(residue);
        let sign = broadcast_scalar(1u64, shape![128]) << broadcast_scalar(63u64, shape![128]);
        let zero = broadcast_scalar(0u64, shape![128]);
        let nonzero = ne_tile(bits & (sign - broadcast_scalar(1u64, shape![128])), zero);
        let opposite = ne_tile((bits ^ b) & sign, zero);
        let corrected = addf(residue, y, rounding::NearestEven, ftz::Disabled);
        // Either zero sign bypasses correction and retains the dividend's sign.
        select(nonzero & opposite, bitcast(corrected), bits)
    }
    else { bitcast(divf(one, x, rounding::NearestEven, ftz::Disabled)) }
}

// Truncated residue plus the existing nonzero, opposite-divisor-sign correction.
fn float_arithmetic_remainder_f32(x: Tile<f32, {[128]}>, y: Tile<f32, {[128]}>) -> Tile<f32, {[128]}> {
    let residue = remf(x, y);
    let bits: Tile<u32, {[128]}> = bitcast(residue);
    let divisor: Tile<u32, {[128]}> = bitcast(y);
    let sign = broadcast_scalar(1u32, shape![128]) << broadcast_scalar(31u32, shape![128]);
    let zero = broadcast_scalar(0u32, shape![128]);
    let nonzero = ne_tile(bits & (sign - broadcast_scalar(1u32, shape![128])), zero);
    let opposite = ne_tile((bits ^ divisor) & sign, zero);
    let corrected = addf(residue, y, rounding::NearestEven, ftz::Disabled);
    // Either zero sign bypasses correction and retains the dividend's sign.
    select(nonzero & opposite, corrected, residue)
}

fn float_arithmetic_f32(a: Tile<u32, {[128]}>, b: Tile<u32, {[128]}>, op: u32) -> Tile<u32, {[128]}> {
    let x: Tile<f32, {[128]}> = bitcast(a);
    let y: Tile<f32, {[128]}> = bitcast(b);
    let one: Tile<f32, {[128]}> = bitcast(broadcast_scalar(1065353216u32, shape![128]));
    if op == 1u32 { bitcast(addf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 2u32 { bitcast(subf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 3u32 { bitcast(mulf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 4u32 { bitcast(divf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 14u32 { bitcast(sqrt(x, rounding::NearestEven, ftz::Disabled)) }
    else if op == 15u32 { bitcast(unsafe { exp_with_rounding(x, rounding::Full) }) }
    else if op == 16u32 { bitcast(log(x)) }
    else if op == 17u32 { float_math_log1p_f32(a) }
    else if op == 18u32 { bitcast(unsafe { tanh_with_rounding(x, rounding::Full) }) }
    else if op == 19u32 { bitcast(sin(x)) }
    else if op == 20u32 { bitcast(cos(x)) }
    else if op == 29u32 { bitcast(unsafe { fpowf(x, y) }) }
    else if op == 30u32 { bitcast(sinh(x)) }
    else if op == 31u32 { bitcast(cosh(x)) }
    else if op == 32u32 { bitcast(tan(x)) }
    else if op == 34u32 { bitcast(float_arithmetic_remainder_f32(x, y)) }
    else { bitcast(divf(one, x, rounding::NearestEven, ftz::Disabled)) }
}

fn float_arithmetic_f16(a: Tile<u16, {[128]}>, b: Tile<u16, {[128]}>, op: u32) -> Tile<u16, {[128]}> {
    let x: Tile<f16, {[128]}> = bitcast(a);
    let y: Tile<f16, {[128]}> = bitcast(b);
    let one: Tile<f16, {[128]}> = bitcast(broadcast_scalar(15360u16, shape![128]));
    if op == 1u32 { bitcast(addf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 2u32 { bitcast(subf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 3u32 { bitcast(mulf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 4u32 { bitcast(divf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 14u32 { bitcast(sqrt(x, rounding::NearestEven, ftz::Disabled)) }
    else if op == 15u32 || op == 16u32 {
        let promoted: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let result = if op == 15u32 { unsafe { exp_with_rounding(promoted, rounding::Full) } } else { log(promoted) };
        let rounded: Tile<f16, {[128]}> = ftof(result, rounding::NearestEven);
        bitcast(rounded)
    }
    else if op >= 18u32 && op <= 20u32 {
        let promoted: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let result = if op == 18u32 { unsafe { tanh_with_rounding(promoted, rounding::Full) } }
            else if op == 19u32 { sin(promoted) } else { cos(promoted) };
        let rounded: Tile<f16, {[128]}> = ftof(result, rounding::NearestEven);
        bitcast(rounded)
    }
    else if op == 17u32 || (op >= 30u32 && op <= 32u32) {
        let promoted: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let result = if op == 17u32 { bitcast(float_math_log1p_f32(bitcast(promoted))) }
            else if op == 30u32 { sinh(promoted) }
            else if op == 31u32 { cosh(promoted) } else { tan(promoted) };
        let rounded: Tile<f16, {[128]}> = ftof(result, rounding::NearestEven);
        bitcast(rounded)
    }
    else if op == 29u32 {
        // Both operands, including a scalar exponent, already have storage precision.
        let x_staged: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let y_staged: Tile<f32, {[128]}> = ftof(y, rounding::NearestEven);
        let result = unsafe { fpowf(x_staged, y_staged) };
        let rounded: Tile<f16, {[128]}> = ftof(result, rounding::NearestEven);
        bitcast(rounded)
    }
    else if op == 34u32 {
        // Native already normalized a scalar operand to this storage format.
        let x_staged: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let y_staged: Tile<f32, {[128]}> = ftof(y, rounding::NearestEven);
        let selected = float_arithmetic_remainder_f32(x_staged, y_staged);
        let rounded: Tile<f16, {[128]}> = ftof(selected, rounding::NearestEven);
        bitcast(rounded)
    }
    else { bitcast(divf(one, x, rounding::NearestEven, ftz::Disabled)) }
}

fn float_arithmetic_bf16(a: Tile<u16, {[128]}>, b: Tile<u16, {[128]}>, op: u32) -> Tile<u16, {[128]}> {
    let x: Tile<bf16, {[128]}> = bitcast(a);
    let y: Tile<bf16, {[128]}> = bitcast(b);
    let one: Tile<bf16, {[128]}> = bitcast(broadcast_scalar(16256u16, shape![128]));
    if op == 1u32 { bitcast(addf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 2u32 { bitcast(subf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 3u32 { bitcast(mulf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 4u32 { bitcast(divf(x, y, rounding::NearestEven, ftz::Disabled)) }
    else if op == 14u32 { bitcast(sqrt(x, rounding::NearestEven, ftz::Disabled)) }
    else if op == 15u32 || op == 16u32 {
        let promoted: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let result = if op == 15u32 { unsafe { exp_with_rounding(promoted, rounding::Full) } } else { log(promoted) };
        let rounded: Tile<bf16, {[128]}> = ftof(result, rounding::NearestEven);
        bitcast(rounded)
    }
    else if op >= 18u32 && op <= 20u32 {
        let promoted: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let result = if op == 18u32 { unsafe { tanh_with_rounding(promoted, rounding::Full) } }
            else if op == 19u32 { sin(promoted) } else { cos(promoted) };
        let rounded: Tile<bf16, {[128]}> = ftof(result, rounding::NearestEven);
        bitcast(rounded)
    }
    else if op == 17u32 || (op >= 30u32 && op <= 32u32) {
        let promoted: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let result = if op == 17u32 { bitcast(float_math_log1p_f32(bitcast(promoted))) }
            else if op == 30u32 { sinh(promoted) }
            else if op == 31u32 { cosh(promoted) } else { tan(promoted) };
        let rounded: Tile<bf16, {[128]}> = ftof(result, rounding::NearestEven);
        bitcast(rounded)
    }
    else if op == 29u32 {
        // Both operands, including a scalar exponent, already have storage precision.
        let x_staged: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let y_staged: Tile<f32, {[128]}> = ftof(y, rounding::NearestEven);
        let result = unsafe { fpowf(x_staged, y_staged) };
        let rounded: Tile<bf16, {[128]}> = ftof(result, rounding::NearestEven);
        bitcast(rounded)
    }
    else if op == 34u32 {
        // Native already normalized a scalar operand to this storage format.
        let x_staged: Tile<f32, {[128]}> = ftof(x, rounding::NearestEven);
        let y_staged: Tile<f32, {[128]}> = ftof(y, rounding::NearestEven);
        let selected = float_arithmetic_remainder_f32(x_staged, y_staged);
        let rounded: Tile<bf16, {[128]}> = ftof(selected, rounding::NearestEven);
        bitcast(rounded)
    }
    else { bitcast(divf(one, x, rounding::NearestEven, ftz::Disabled)) }
}

fn float_arithmetic_value(left: Tile<u64, {[128]}>, right: Tile<u64, {[128]}>, format: u32, op: u32) -> Tile<u64, {[128]}> {
    let sign = broadcast_scalar(1u64, shape![128]) << broadcast_scalar(if format == 0u32 { 63u64 } else if format <= 2u32 { 31u64 } else { 15u64 }, shape![128]);
    // Transform stored bits before any floating operation, preserving NaN payloads.
    if op == 11u32 { left ^ sign }
    else if op == 12u32 { left & (sign - broadcast_scalar(1u64, shape![128])) }
    else if op == 25u32 {
        // Integer IEEE classification preserves even the smallest half subnormal.
        // Either zero sign and every NaN yield +0; infinities retain their sign.
        let magnitude = left & (sign - broadcast_scalar(1u64, shape![128]));
        let infinity = broadcast_scalar(if format == 0u32 { 2146435072u64 << 32u64 }
            else if format <= 2u32 { 2139095040u64 }
            else if format == 3u32 { 31744u64 } else { 32640u64 }, shape![128]);
        let ordered_nonzero = ne_tile(magnitude, broadcast_scalar(0u64, shape![128])) & le_tile(magnitude, infinity);
        select(ordered_nonzero, (left & sign) | broadcast_scalar(float_arithmetic_one(format), shape![128]), broadcast_scalar(0u64, shape![128]))
    }
    else if op >= 21u32 && op <= 24u32 {
        if format == 0u32 { float_arithmetic_integral_u64(left, op, 52u64, 1023u64, 63u64) }
        else {
            let fraction = if format <= 2u32 { 23u32 } else if format == 3u32 { 10u32 } else { 7u32 };
            let bias = if format == 3u32 { 15u32 } else { 127u32 };
            let sign_shift = if format <= 2u32 { 31u32 } else { 15u32 };
            exti(float_arithmetic_integral_u32(packed_low(left), op, fraction, bias, sign_shift))
        }
    }
    else if format == 0u32 { float_arithmetic_f64(left, right, op) }
    else if format <= 2u32 { exti(float_arithmetic_f32(packed_low(left), packed_low(right), op)) }
    else {
        let a: Tile<u16, {[128]}> = trunci(left & broadcast_scalar(65535u64, shape![128]), overflow::NoUnsignedWrap);
        let b: Tile<u16, {[128]}> = trunci(right & broadcast_scalar(65535u64, shape![128]), overflow::NoUnsignedWrap);
        let bits = if format == 3u32 { float_arithmetic_f16(a, b, op) } else { float_arithmetic_bf16(a, b, op) };
        exti(bits)
    }
}

unsafe fn float_arithmetic_read(input: *const u32, address: Tile<i32, {[128]}>, width: u32, extent: u32, valid: Tile<bool, {[128]}>) -> Tile<u64, {[128]}> {
    let nonnegative = ge_tile(address, broadcast_scalar(0i32, shape![128]));
    let address: Tile<u32, {[128]}> = bitcast(address);
    let valid = valid & nonnegative & lt_tile(address, broadcast_scalar(extent, shape![128]));
    let address = select(valid, address, broadcast_scalar(0u32, shape![128]));
    let per_word = if width == 3u32 { 1u32 } else { 4u32 >> width };
    let words = if width == 3u32 { extent * 2u32 } else { (extent + per_word - 1u32) / per_word };
    let last_word = if width == 3u32 { address * broadcast_scalar(2u32, shape![128]) + broadcast_scalar(1u32, shape![128]) }
    else { address / broadcast_scalar(per_word, shape![128]) };
    // The high F64 word must also fit the unsigned physical pointer range.
    let valid = valid & lt_tile(last_word, broadcast_scalar(words, shape![128]));
    unsafe { packed_read_width(input, address, width, valid) }
}

#[cutile::entry()]
unsafe fn burn_float_arithmetic(a: *const u32, b: *const u32, output: *mut u32, FLOAT_PARAMETERS) {
    let owner = indices();
    let format = (operation >> 8u32) & 255u32;
    let op = operation & 255u32;
    let scalar_rhs = operation & 16777216u32 != 0u32;
    let unary = (op >= 11u32 && op <= 20u32) || (op >= 21u32 && op <= 25u32) || (op >= 30u32 && op <= 32u32);
    let width = float_arithmetic_width(format);
    let per_word = if width == 3u32 { 1u32 } else { 4u32 >> width };
    let writers = (count + per_word - 1u32) / per_word;
    let one = broadcast_scalar(float_arithmetic_one(format), shape![128]);
    let mut result = broadcast_scalar(0u32, shape![128]);
    for slot in 0u32..per_word {
        let logical = owner * broadcast_scalar(per_word, shape![128]) + broadcast_scalar(slot, shape![128]);
        let valid = lt_tile(logical, broadcast_scalar(count, shape![128]));
        // Inactive lanes must not feed oversized signed coordinates to layout.
        let mut linear = select(valid, logical, broadcast_scalar(0u32, shape![128]));
        let mut address_a = broadcast_scalar(signed(offset_a), shape![128]);
        let mut address_b = broadcast_scalar(signed(if scalar_rhs || unary { 0u32 } else { offset_b }), shape![128]);
        FLOAT_ADDRESSES
        let left = unsafe { float_arithmetic_read(a, address_a, width, extent_a, valid) };
        let right = if scalar_rhs {
            let low: Tile<u64, {[128]}> = exti(broadcast_scalar(scalar, shape![128]));
            let high: Tile<u64, {[128]}> = exti(broadcast_scalar(offset_b, shape![128]));
            low | (high << broadcast_scalar(32u64, shape![128]))
        } else if unary { one }
        else { unsafe { float_arithmetic_read(b, address_b, width, extent_b, valid) } };
        // A store mask does not suppress evaluation. One is a safe inactive
        // divisor for both ordinary division and the reciprocal's lhs input.
        let left = select(valid, left, one);
        let right = select(valid, right, one);
        let value = float_arithmetic_value(left, right, format, op);
        let value = select(valid, value, broadcast_scalar(0u64, shape![128]));
        if width == 3u32 {
            let word = owner * broadcast_scalar(2u32, shape![128]);
            unsafe { write_tile(output, word, packed_low(value), valid) };
            unsafe { write_tile(output, word + broadcast_scalar(1u32, shape![128]), packed_low(value >> broadcast_scalar(32u64, shape![128])), valid) };
        } else {
            result = result | (packed_low(value) << broadcast_scalar(slot * (8u32 << width), shape![128]));
        }
    }
    if width != 3u32 {
        // One owner stores the whole packed word, including a zero odd tail.
        unsafe { write_tile(output, owner, result, lt_tile(owner, broadcast_scalar(writers, shape![128]))) };
    }
}
