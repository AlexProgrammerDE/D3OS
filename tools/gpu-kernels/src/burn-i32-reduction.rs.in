#[cutile::entry()]
unsafe fn REDUCE_ENTRY(input: *const u32, output: *mut u32, REDUCE_PARAMETERS) {
    let row = block_id();
    let mut linear = row;
    let mut base = signed(offset);
    REDUCE_ADDRESSES
    let step = REDUCE_STRIDE;
    let lane = lanes::<128>();
    let result: u32 = if REDUCE_OP < 3u32 {
        // Unsigned accumulation specifies modulo-2^32 arithmetic, including
        // products. Converting to FP32 would lose integer bits above 2^24.
        let mut values = broadcast_scalar(if REDUCE_OP == 2u32 { 1u32 } else { 0u32 }, shape![128]);
        let mut start = 0u32;
        while start < length {
            let col = lane + broadcast_scalar(start, shape![128]);
            let mask = lt_tile(col, broadcast_scalar(length, shape![128]));
            let signed_col: Tile<i32, { [128] }> = bitcast(col);
            let address = broadcast_scalar(base, shape![128]) + signed_col * broadcast_scalar(signed(step), shape![128]);
            let address: Tile<u32, { [128] }> = bitcast(address);
            let x = unsafe { read_tile(input, address, mask & lt_tile(address, broadcast_scalar(extent, shape![128])), 0u32) };
            values = if REDUCE_OP == 2u32 {
                values * select(mask, x, broadcast_scalar(1u32, shape![128]))
            } else {
                values + select(mask, x, broadcast_scalar(0u32, shape![128]))
            };
            start = start + 128u32;
        }
        let value: Tile<u32, { [] }> = if REDUCE_OP == 2u32 { reduce_prod(values, 0i32) } else { reduce_sum(values, 0i32) };
        let value: u32 = tile_to_scalar(value);
        if REDUCE_OP == 1u32 { unsigned(signed(value) / signed(length)) } else { value }
    } else {
        let mut best = broadcast_scalar(REDUCE_IDENTITY, shape![128]);
        let sentinel = broadcast_scalar(unsigned(-1i32), shape![128]);
        let mut winner = sentinel;
        let mut start = 0u32;
        while start < length {
            let col = lane + broadcast_scalar(start, shape![128]);
            let mask = lt_tile(col, broadcast_scalar(length, shape![128]));
            let signed_col: Tile<i32, { [128] }> = bitcast(col);
            let address = broadcast_scalar(base, shape![128]) + signed_col * broadcast_scalar(signed(step), shape![128]);
            let address: Tile<u32, { [128] }> = bitcast(address);
            let bits = unsafe { read_tile(input, address, mask & lt_tile(address, broadcast_scalar(extent, shape![128])), 0u32) };
            let x: Tile<i32, { [128] }> = bitcast(bits);
            let better = REDUCE_COMPARE(x, best);
            let take = mask & (better | (eq_tile(x, best) & lt_tile(col, winner)));
            best = select(take, x, best);
            winner = select(take, col, winner);
            start = start + 128u32;
        }
        let extreme: Tile<i32, { [] }> = REDUCE_EXTREME(best, 0i32);
        let extreme: i32 = tile_to_scalar(extreme);
        if REDUCE_OP == 5u32 || REDUCE_OP == 6u32 {
            let winners = select(eq_tile(broadcast_scalar(extreme, shape![128]), best), winner, sentinel);
            let winner: Tile<u32, { [] }> = reduce_min(winners, 0i32);
            tile_to_scalar(winner)
        } else {
            unsigned(extreme)
        }
    };
    unsafe { write_tile(output, broadcast_scalar(row, shape![1]), broadcast_scalar(result, shape![1]), broadcast_scalar(row < count, shape![1])) };
}
