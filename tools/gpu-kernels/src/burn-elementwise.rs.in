#[cutile::entry()]
unsafe fn BURN_ENTRY(a: *const u32, b: *const u32, output: *mut u32, BURN_PARAMETERS) {
    let i = indices();
    let mask = lt_tile(i, broadcast_scalar(count, shape![128]));
    let mut linear = i;
    let mut address_a = broadcast_scalar(signed(offset_a), shape![128]);
    let mut address_b = broadcast_scalar(signed(offset_b), shape![128]);
    BURN_ADDRESSES
    let address_a: Tile<u32, { [128] }> = bitcast(address_a);
    let address_b: Tile<u32, { [128] }> = bitcast(address_b);
    let left = unsafe { read_tile(a, address_a, mask & lt_tile(address_a, broadcast_scalar(extent_a, shape![128])), 0u32) };
    let right = if operation & 65536u32 != 0u32 {
        broadcast_scalar(scalar, shape![128])
    } else {
        unsafe { read_tile(b, address_b, mask & lt_tile(address_b, broadcast_scalar(extent_b, shape![128])), 0u32) }
    };
    let x: Tile<f32, { [128] }> = bitcast(left);
    let y: Tile<f32, { [128] }> = bitcast(right);
    let zero = broadcast_scalar(0u32, shape![128]);
    let one = broadcast_scalar(1u32, shape![128]);
    let result: Tile<u32, { [128] }> = if BURN_OP == 0u32 {
        if operation & 65536u32 != 0u32 { broadcast_scalar(scalar, shape![128]) } else { left }
    } else if BURN_OP == 1u32 {
        bitcast(x + y)
    } else if BURN_OP == 2u32 {
        bitcast(x - y)
    } else if BURN_OP == 3u32 {
        bitcast(x * y)
    } else if BURN_OP == 4u32 {
        bitcast(x / y)
    } else if BURN_OP == 5u32 {
        select(eq_tile(x, y), one, zero)
    } else if BURN_OP == 6u32 {
        select(gt_tile(x, y), one, zero)
    } else if BURN_OP == 7u32 {
        select(ge_tile(x, y), one, zero)
    } else if BURN_OP == 8u32 {
        select(lt_tile(x, y), one, zero)
    } else if BURN_OP == 9u32 {
        select(le_tile(x, y), one, zero)
    } else if BURN_OP == 10u32 {
        select(eq_tile(right, zero), left, broadcast_scalar(scalar, shape![128]))
    } else if BURN_OP == 11u32 {
        left ^ broadcast_scalar(unsigned(-1i32) << 31u32, shape![128])
    } else if BURN_OP == 12u32 {
        left & broadcast_scalar(0x7fffffffu32, shape![128])
    } else if BURN_OP == 13u32 {
        bitcast(divf(broadcast_scalar(1f32, shape![128]), x, rounding::NearestEven, ftz::Disabled))
    } else if BURN_OP == 14u32 {
        bitcast(sqrt(x, rounding::NearestEven, ftz::Disabled))
    } else if BURN_OP == 15u32 {
        bitcast(unsafe { exp_with_rounding(x, rounding::Full) })
    } else if BURN_OP == 16u32 {
        bitcast(log(x))
    } else if BURN_OP == 17u32 {
        burn_log1p_bits(left)
    } else if BURN_OP == 18u32 {
        bitcast(unsafe { tanh_with_rounding(x, rounding::Full) })
    } else if BURN_OP == 19u32 {
        bitcast(sin(x))
    } else if BURN_OP == 20u32 {
        bitcast(cos(x))
    } else if BURN_OP == 21u32 {
        bitcast(floor(x))
    } else if BURN_OP == 22u32 {
        bitcast(ceil(x))
    } else if BURN_OP == 23u32 {
        burn_round_even(left)
    } else if BURN_OP == 24u32 {
        bitcast(select(lt_tile(x, broadcast_scalar(0f32, shape![128])), ceil(x), floor(x)))
    } else if BURN_OP == 25u32 {
        let positive = gt_tile(x, broadcast_scalar(0f32, shape![128]));
        let negative = lt_tile(x, broadcast_scalar(0f32, shape![128]));
        bitcast(select(positive, broadcast_scalar(1f32, shape![128]), select(negative, broadcast_scalar(-1f32, shape![128]), broadcast_scalar(0f32, shape![128]))))
    } else if BURN_OP == 26u32 {
        let ordered: Tile<bool, { [128] }> = eq_tile(x, x);
        select(eq_tile(ordered, broadcast_scalar(false, shape![128])), one, zero)
    } else if BURN_OP == 27u32 {
        select(eq_tile(left & broadcast_scalar(0x7fffffffu32, shape![128]), broadcast_scalar(0x7f800000u32, shape![128])), one, zero)
    } else if BURN_OP == 28u32 {
        select(lt_tile(left & broadcast_scalar(0x7fffffffu32, shape![128]), broadcast_scalar(0x7f800000u32, shape![128])), one, zero)
    } else if BURN_OP == 29u32 {
        bitcast(unsafe { fpowf(x, y) })
    } else if BURN_OP == 30u32 {
        bitcast(sinh(x))
    } else if BURN_OP == 31u32 {
        bitcast(cosh(x))
    } else if BURN_OP == 32u32 {
        bitcast(tan(x))
    } else if BURN_OP == 33u32 {
        burn_erf_bits(left)
    } else if BURN_OP == 34u32 {
        burn_remainder_bits(left, right)
    } else if BURN_OP == 35u32 {
        burn_acos_bits(left)
    } else if BURN_OP == 36u32 {
        burn_acosh_bits(left)
    } else if BURN_OP == 37u32 {
        burn_asin_bits(left)
    } else if BURN_OP == 38u32 {
        burn_asinh_bits(left)
    } else if BURN_OP == 39u32 {
        burn_atan_bits(left)
    } else if BURN_OP == 40u32 {
        burn_atanh_bits(left)
    } else {
        bitcast(atan2(x, y))
    };
    unsafe { write_tile(output, i, result, mask) };
}
